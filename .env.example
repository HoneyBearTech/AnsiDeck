# ---- Backend ----
ENVIRONMENT=development

# Settings can also come from files, one per setting, named after it (e.g. credential_encryption_key):
# Docker secrets appear in /run/secrets. The environment wins when both are set. API only.
# SECRETS_DIR=/run/secrets
AUTH_SECRET_KEY=change-me-to-a-long-random-string
# With ENVIRONMENT=production the app refuses to start while AUTH_SECRET_KEY, ADMIN_PASSWORD or
# any other secret here still holds a default or a "change-me" placeholder, or AUTH_SECRET_KEY has
# fewer than 32 characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Bootstrap-only: seed the single admin user in the DB on first startup (only if
# the users table is empty). Not checked on every login: after the first start,
# change the password in the UI under Account (click your username in the header).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Fernet key encrypting stored secrets (SSH keys, vault passwords, tokens) at rest. This example
# value is a real, valid key, fine for local dev only: ENVIRONMENT=production refuses it. Every real
# deployment needs its own, kept secret (losing it makes stored secrets unrecoverable; leaking it
# exposes them). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To change it, list the new key first and the old one after a comma, restart, run
# `python -m app.cli reencrypt-secrets` in the backend container, then drop the old key
# (docs/upgrading.md).
CREDENTIAL_ENCRYPTION_KEY=R_7QcKt5d6tHB-rDQU_gp4q4YaECbGwV-pehrJOn3NM=

CORS_ORIGINS=["http://localhost:5173"]
# Host names the backend answers to; empty means localhost, 127.0.0.1 and the compose service
# name. Add yours to reach the backend's port directly under another name (e.g. a LAN address).
ALLOWED_HOSTS=[]

# ---- Database (Postgres) ----
# The compose `postgres` service uses this password on first start (it's stored in the
# postgres-data volume, so changing it later needs ALTER USER too). The backend's
# DATABASE_URL is built from it; set DATABASE_URL instead to use an external Postgres.
# Unset, it is "ansideck", which the backend tests and a standalone `fastapi dev` expect
# (otherwise set TEST_DATABASE_URL / DATABASE_URL to match). With ENVIRONMENT=production
# the app refuses that default, so set a real one there.
# POSTGRES_PASSWORD=change-me-db-password
# DATABASE_URL=postgresql+psycopg://ansideck:<password>@<host>:5432/ansideck
# Host port for the postgres service (published on 127.0.0.1 only, for running tests).
POSTGRES_PORT=5433

# ---- Workers ----
# Runs execute in separate worker containers (compose service `worker`, scale it with
# `docker compose up --scale worker=N`). Workers reach only the API's internal port 8001
# (never published) and authenticate with this shared token; they get no database access and
# no encryption key. Compose passes the same value to the backend and the workers. With
# ENVIRONMENT=production both refuse the default: set a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# WORKER_TOKEN=change-me-to-a-long-random-token
# Runs each worker executes at once.
WORKER_SLOTS=2

# ---- Git sources (optional) ----
# Projects can sync playbooks from git repositories. Remotes on loopback, private, link-local or
# other non-public addresses (a Gitea on your LAN, say) are refused unless listed here
# (comma-separated host names, addresses or CIDRs); plain http:// only works to those.
GIT_ALLOWED_PRIVATE_HOSTS=
# Limits per source: fetch timeout, mirror size, what one commit may hold.
# GIT_SYNC_TIMEOUT_SECONDS=300
# GIT_MAX_REPO_MB=500
# GIT_MAX_SNAPSHOT_MB=50
# GIT_MAX_FILES=20000

# ---- Secret store (optional): OpenBao or HashiCorp Vault ----
# Credentials and vault passwords can live in a KV v2 secret store instead of AnsiDeck's
# database: each project reads only <KV mount>/<path prefix>/<project id>/. Off unless
# SECRETS_STORE_URL is set (https; http only to localhost in production). AnsiDeck logs in
# with a token from a file (e.g. written by an Agent) or AppRole (secret id in a file); give
# it a read-only policy on its prefix (see the README). Never give workers these settings.
# To try it locally: the compose `openbao` profile and scripts/openbao_dev_setup.py print
# the lines to use here (see the README).
# SECRETS_STORE_URL=https://openbao.lan:8200
# SECRETS_STORE_AUTH=approle
# SECRETS_STORE_ROLE_ID=
# SECRETS_STORE_SECRET_ID_FILE=/run/secrets/ansideck_secret_id
# SECRETS_STORE_TOKEN_FILE=
# SECRETS_STORE_CA_CERT=
# SECRETS_STORE_NAMESPACE=
# SECRETS_STORE_KV_MOUNT=secret
# SECRETS_STORE_PATH_PREFIX=ansideck
# SECRETS_STORE_PROJECT_POLICY=ansideck-project-{project_id}
# SECRETS_STORE_LABEL=OpenBao

# ---- Dynamic inventory sources ----
# A refresh runs the inventory's plugin configs (ansible-inventory) in an isolated worker.
# INVENTORY_REFRESH_TIMEOUT_SECONDS=300
# INVENTORY_MAX_OUTPUT_MB=32
# INVENTORY_MAX_HOSTS=20000
# INVENTORY_MAX_GROUPS=5000

# ---- Playbook checks ----
# The editor's Check button runs ansible-lint in a worker; at most this many checks run at once
# across all workers (they share slots with runs), each stopped after the timeout.
# LINT_TIMEOUT_SECONDS=120
# LINT_MAX_RUNNING=2

# ---- Metrics (optional) ----
# Prometheus metrics are served on the backend's port 8002 (/metrics) only when this is set,
# to scrapers that send it as a bearer token. It must differ from WORKER_TOKEN and
# AUTH_SECRET_KEY; with ENVIRONMENT=production it needs 32+ characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Compose publishes the port on 127.0.0.1 only (BACKEND_METRICS_PORT on the host).
# METRICS_TOKEN=

# ---- Optional single sign-on ----
# Leave everything below empty to keep password login only. Accounts are pre-provisioned
# only: an admin creates the user and sets their email under Users; the first SSO sign-in
# links by a provider-*verified* email. Nothing is auto-created.
# PUBLIC_URL is the browser-visible base URL of this app (both providers build their
# callback from it). In production it and the provider URLs must be https.
PUBLIC_URL=

# -- OpenID Connect (Google, Entra, Keycloak, Authentik, Dex, ...) --
# Set ISSUER, CLIENT_ID and CLIENT_SECRET together (a partial config refuses to start).
# Register  <PUBLIC_URL>/api/auth/oidc/callback  as the redirect URI at your provider.
# OIDC_ISSUER must match the provider's "issuer" exactly
# (see <issuer>/.well-known/openid-configuration).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_BUTTON_LABEL=SSO

# -- GitHub (native "Sign in with GitHub"; GitHub is not an OIDC provider) --
# Create an OAuth App (GitHub > Settings > Developer settings > OAuth Apps) with the callback
#   <PUBLIC_URL>/api/auth/github/callback
# and set both values (one without the other refuses to start). Only *verified* emails on the
# GitHub account can link. For GitHub Enterprise Server also set GITHUB_URL and GITHUB_API_URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_URL=https://github.com
GITHUB_API_URL=https://api.github.com
GITHUB_BUTTON_LABEL=GitHub

# -- Applies to every SSO provider --
# Global admins cannot sign in with SSO unless this is true (they stay local/break-glass).
# (SSO_ALLOW_ADMIN and SSO_ALLOWED_EMAIL_DOMAINS were called OIDC_* before; the old names
# still work.)
SSO_ALLOW_ADMIN=false
# JSON list; empty allows any verified email. Example: ["corp.example.com"]
SSO_ALLOWED_EMAIL_DOMAINS=[]

# The API takes the client's address from X-Real-IP only from these peers (and loopback): host names,
# addresses or CIDRs, comma-separated. The default is the compose frontend service, whose nginx sets it.
# TRUSTED_PROXY_HOSTS=frontend

# Audit log entries older than this are pruned at startup (0 = keep forever).
AUDIT_RETENTION_DAYS=365

# ---- Notifications (optional) ----
# Webhooks may not point at loopback, private, link-local or other non-public addresses
# unless listed here (comma-separated host names, addresses or CIDRs), e.g. a LAN service:
NOTIFY_ALLOWED_PRIVATE_HOSTS=
# Ops alerts: a worker is reported offline after this many seconds without a heartbeat, and
# the queue as stuck once a run has waited this many minutes for a worker.
NOTIFY_WORKER_OFFLINE_SECONDS=120
NOTIFY_QUEUE_STUCK_MINUTES=10
# Email channels send through this one SMTP server; leave SMTP_HOST empty for no email.
# SMTP_TLS: starttls (port 587), tls (port 465) or none (production refuses none to a
# remote server).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls
COOKIE_SECURE=false

# ---- Frontend (build-time only; Vite inlines VITE_* vars) ----
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8000

# ---- Docker Compose port mapping ----
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Both ports are published on this machine only. 0.0.0.0 makes the dev setup reachable from your
# network: change ADMIN_PASSWORD (and sign in to change it in the app) before you do that.
DEV_BIND_ADDRESS=127.0.0.1
