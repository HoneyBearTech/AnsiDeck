# ---- Backend ----
ENVIRONMENT=development
AUTH_SECRET_KEY=change-me-to-a-long-random-string
# With ENVIRONMENT=production the app refuses to start if AUTH_SECRET_KEY or
# ADMIN_PASSWORD still hold their insecure defaults.

# Bootstrap-only: seed the single admin user in the DB on first startup (only if
# the users table is empty). Not checked on every login: after the first start,
# change the password in the UI under Account (click your username in the header).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Fernet key encrypting SSH credential secrets at rest. This example value is a
# real, valid Fernet key — fine for local dev, but every real deployment MUST
# regenerate its own and keep it secret (losing it makes stored credentials
# unrecoverable; leaking it exposes every stored SSH key). Regenerate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=R_7QcKt5d6tHB-rDQU_gp4q4YaECbGwV-pehrJOn3NM=

CORS_ORIGINS=["http://localhost:5173"]

# ---- Database (Postgres) ----
# The compose `postgres` service uses this password on first start (it's stored in the
# postgres-data volume, so changing it later needs ALTER USER too). The backend's
# DATABASE_URL is built from it; set DATABASE_URL instead to use an external Postgres.
# Unset, it is "ansideck", which the backend tests and a standalone `fastapi dev` expect
# (otherwise set TEST_DATABASE_URL / DATABASE_URL to match). With ENVIRONMENT=production
# the app refuses that default, so set a real one there.
# POSTGRES_PASSWORD=change-me-db-password
# DATABASE_URL=postgresql+psycopg://ansideck:<password>@<host>:5432/ansideck
# Host port for the postgres service (published on 127.0.0.1 only, for running tests).
POSTGRES_PORT=5433

# ---- Workers ----
# Runs execute in separate worker containers (compose service `worker`, scale it with
# `docker compose up --scale worker=N`). Workers reach only the API's internal port 8001
# (never published) and authenticate with this shared token; they get no database access and
# no encryption key. Compose passes the same value to the backend and the workers. With
# ENVIRONMENT=production both refuse the default: set a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# WORKER_TOKEN=change-me-to-a-long-random-token
# Runs each worker executes at once.
WORKER_SLOTS=2

# ---- Optional single sign-on ----
# Leave everything below empty to keep password login only. Accounts are pre-provisioned
# only: an admin creates the user and sets their email under Users; the first SSO sign-in
# links by a provider-*verified* email. Nothing is auto-created.
# PUBLIC_URL is the browser-visible base URL of this app (both providers build their
# callback from it). In production it and the provider URLs must be https.
PUBLIC_URL=

# -- OpenID Connect (Google, Entra, Keycloak, Authentik, Dex, ...) --
# Set ISSUER, CLIENT_ID and CLIENT_SECRET together (a partial config refuses to start).
# Register  <PUBLIC_URL>/api/auth/oidc/callback  as the redirect URI at your provider.
# OIDC_ISSUER must match the provider's "issuer" exactly
# (see <issuer>/.well-known/openid-configuration).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_BUTTON_LABEL=SSO

# -- GitHub (native "Sign in with GitHub"; GitHub is not an OIDC provider) --
# Create an OAuth App (GitHub > Settings > Developer settings > OAuth Apps) with the callback
#   <PUBLIC_URL>/api/auth/github/callback
# and set both values (one without the other refuses to start). Only *verified* emails on the
# GitHub account can link. For GitHub Enterprise Server also set GITHUB_URL and GITHUB_API_URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_URL=https://github.com
GITHUB_API_URL=https://api.github.com
GITHUB_BUTTON_LABEL=GitHub

# -- Applies to every SSO provider --
# Global admins cannot sign in with SSO unless this is true (they stay local/break-glass).
# (SSO_ALLOW_ADMIN and SSO_ALLOWED_EMAIL_DOMAINS were called OIDC_* before; the old names
# still work.)
SSO_ALLOW_ADMIN=false
# JSON list; empty allows any verified email. Example: ["corp.example.com"]
SSO_ALLOWED_EMAIL_DOMAINS=[]

# Audit log entries older than this are pruned at startup (0 = keep forever).
AUDIT_RETENTION_DAYS=365
COOKIE_SECURE=false

# ---- Frontend (build-time only; Vite inlines VITE_* vars) ----
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8000

# ---- Docker Compose port mapping ----
BACKEND_PORT=8000
FRONTEND_PORT=5173
