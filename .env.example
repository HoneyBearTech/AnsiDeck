# ---- Backend ----
ENVIRONMENT=development
AUTH_SECRET_KEY=change-me-to-a-long-random-string
# With ENVIRONMENT=production the app refuses to start if AUTH_SECRET_KEY or
# ADMIN_PASSWORD still hold their insecure defaults.

# Bootstrap-only: seed the single admin user in the DB on first startup (only if
# the users table is empty). Not checked on every login — after first boot,
# change your password via the UI instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Fernet key encrypting SSH credential secrets at rest. This example value is a
# real, valid Fernet key — fine for local dev, but every real deployment MUST
# regenerate its own and keep it secret (losing it makes stored credentials
# unrecoverable; leaking it exposes every stored SSH key). Regenerate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=R_7QcKt5d6tHB-rDQU_gp4q4YaECbGwV-pehrJOn3NM=

CORS_ORIGINS=["http://localhost:5173"]

# ---- Optional single sign-on (OpenID Connect) ----
# Leave all of these empty to keep password login only. To enable SSO set ISSUER, CLIENT_ID,
# CLIENT_SECRET and PUBLIC_URL together (a partial config refuses to start). Register
#   <PUBLIC_URL>/api/auth/oidc/callback
# as the redirect URI at your identity provider. OIDC_ISSUER must match the provider's
# "issuer" exactly (see <issuer>/.well-known/openid-configuration).
# Accounts are pre-provisioned only: an admin creates the user and sets their email under
# Users; the first SSO sign-in links by the provider-verified email. Nothing is auto-created.
# Global admins cannot sign in with SSO unless OIDC_ALLOW_ADMIN=true (they stay local).
PUBLIC_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_BUTTON_LABEL=SSO
OIDC_ALLOW_ADMIN=false
# JSON list; empty allows any verified email. Example: ["corp.example.com"]
OIDC_ALLOWED_EMAIL_DOMAINS=[]

# Audit log entries older than this are pruned at startup (0 = keep forever).
AUDIT_RETENTION_DAYS=365
COOKIE_SECURE=false

# ---- Frontend (build-time only; Vite inlines VITE_* vars) ----
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8000

# ---- Docker Compose port mapping ----
BACKEND_PORT=8000
FRONTEND_PORT=5173
