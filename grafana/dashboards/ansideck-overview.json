{
  "uid": "ansideck-overview",
  "title": "AnsiDeck: overview & runs",
  "description": "Health right now (Prometheus) and run history (the analytics views).",
  "tags": [
    "ansideck"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "",
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "prometheus",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "type": "datasource",
        "name": "postgres",
        "label": "AnsiDeck database",
        "query": "grafana-postgresql-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "type": "query",
        "name": "project",
        "label": "Project",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${postgres}"
        },
        "query": "SELECT project AS __text, project_id AS __value FROM analytics.projects ORDER BY project",
        "definition": "SELECT project AS __text, project_id AS __value FROM analytics.projects ORDER BY project",
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "sort": 0,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "type": "textbox",
        "name": "ansideck_url",
        "label": "AnsiDeck URL",
        "description": "Your PUBLIC_URL (e.g. https://ansideck.example.com), for links to runs",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Failed runs",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${postgres}"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "refId": "Anno",
          "rawSql": "\n    SELECT finished_at AS time, 'Run #' || run_id || ' ' || status || ': ' || playbook_name AS text,\n           project AS tags\n    FROM analytics.runs WHERE status IN ('failed', 'timed_out') AND $__timeFilter(finished_at) AND project_id IN ($project)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ansideck"
      ],
      "asDropdown": true,
      "title": "AnsiDeck",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "id": 1,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Database",
      "description": "Whether the metrics' last database read worked.",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "ansideck_db_up",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
