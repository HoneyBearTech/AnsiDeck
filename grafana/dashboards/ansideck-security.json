{
  "uid": "ansideck-security",
  "title": "AnsiDeck: security & access",
  "description": "Sign-ins, refusals and admin changes (Prometheus and the analytics views).",
  "tags": [
    "ansideck"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "",
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "prometheus",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "type": "datasource",
        "name": "postgres",
        "label": "AnsiDeck database",
        "query": "grafana-postgresql-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Access changes",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${postgres}"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "refId": "Anno",
          "rawSql": "\n    SELECT created_at AS time, action || ': ' || coalesce(target_name, '') || ' by '\n           || coalesce(actor_username, '?') AS text, 'access' AS tags\n    FROM analytics.audit_events\n    WHERE $__timeFilter(created_at)\n      AND (action ~ '^(user|project\\.member)\\.' OR action = 'auth.totp_disable')",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ansideck"
      ],
      "asDropdown": true,
      "title": "AnsiDeck",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "id": 1,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Failed sign-ins",
      "description": "Wrong passwords, second factors and re-authentications.",
      "id": 2,
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(ansideck_audit_events_total{action=\"auth.login\",outcome=\"failure\"}[$__rate_interval]))",
          "legendFormat": "failed sign-ins",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "stat",
      "title": "Lockouts",
      "description": "Failed sign-ins that locked out a user name or address in the selected time range. Counts restart with the API process.",
      "id": 3,
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(ansideck_login_lockouts_total[$__range]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Refused tokens and permission denials",
      "description": "Bad API keys, wrong worker or metrics tokens, and permission denials.",
      "id": 4,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (action) (increase(ansideck_audit_events_total{action=~\"apikey.auth|worker.auth_failed|metrics.auth_failed|permission.denied\",outcome!=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{action}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Refused HTTP requests by route",
      "description": "401, 403 and 429 answers (public and internal API).",
      "id": 5,
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (route, status) (increase(ansideck_http_requests_total{status=~\"401|403|429\"}[$__rate_interval]))",
          "legendFormat": "{{status}} {{route}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Sign-ins",
      "id": 6,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "type": "timeseries",
      "title": "Sign-ins by outcome and method",
      "description": "Successful sign-ins by method (password, password+totp, sso, github, ...) and failures.",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1h'), CASE WHEN outcome = 'success' THEN coalesce(login_method, 'success') ELSE 'failed' END AS metric, count(*) AS value FROM analytics.audit_events WHERE action = 'auth.login' AND $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "piechart",
      "title": "Failed sign-ins by reason",
      "description": "",
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "rawSql": "SELECT coalesce(reason, 'unknown') AS reason, count(*) AS failures FROM analytics.audit_events WHERE action = 'auth.login' AND outcome = 'failure' AND $__timeFilter(created_at) GROUP BY 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value"
          ]
        },
        "displayLabels": []
      }
    },
    {
      "type": "table",
      "title": "Most-tried user names",
      "description": "Failed sign-ins per user name tried (names that don't exist included).",
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "rawSql": "SELECT actor_username AS \"user name\", count(*) AS failures, count(*) FILTER (WHERE locked_out) AS lockouts, count(DISTINCT client_network) AS networks, max(created_at) AS last FROM analytics.audit_events WHERE action = 'auth.login' AND outcome = 'failure' AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 15",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "table",
      "title": "Failed sign-ins by source network",
      "description": "Addresses are cut to their /24 (IPv4) or /48 (IPv6) network.",
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "rawSql": "SELECT coalesce(client_network, 'unknown') AS network, count(*) AS failures, count(*) FILTER (WHERE locked_out) AS lockouts, count(DISTINCT actor_username) AS \"user names\", max(created_at) AS last FROM analytics.audit_events WHERE action = 'auth.login' AND outcome = 'failure' AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 15",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "row",
      "title": "Access",
      "id": 11,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "type": "table",
      "title": "Admin and access changes",
      "description": "Users, project members, API keys, credentials, vault passwords and notification channels created, changed or removed.",
      "id": 12,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "rawSql": "SELECT created_at AS time, action, actor_username AS \"by\", target_type AS target, target_name AS name, project_id AS project, outcome FROM analytics.audit_events WHERE $__timeFilter(created_at) AND (action ~ '^(user|project\\.member|apikey\\.(create|revoke)|credential|vault_password|notification_channel)\\.' OR action IN ('auth.totp_disable', 'auth.sso_link')) ORDER BY created_at DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "table",
      "title": "Permission denials",
      "description": "",
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "rawSql": "SELECT created_at AS time, actor_username AS \"by\", actor_kind AS kind, required_permission AS needed, reason, target_type AS target, project_id AS project FROM analytics.audit_events WHERE action = 'permission.denied' AND $__timeFilter(created_at) ORDER BY created_at DESC LIMIT 30",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "table",
      "title": "API keys to look at",
      "description": "Expired, expiring within 14 days, never used, or unused for 30 days.",
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "rawSql": "SELECT p.project, k.name, k.preset, k.state, k.expires_at AS expires, k.last_used_at AS \"last used\", k.created_by AS \"created by\" FROM analytics.api_keys k JOIN analytics.projects p USING (project_id) WHERE k.state = 'expired' OR (k.state = 'active' AND (k.expires_at < now() + interval '14 days' OR k.last_used_at IS NULL OR k.last_used_at < now() - interval '30 days')) ORDER BY k.expires_at",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "type": "table",
      "title": "Users",
      "description": "Counts only.",
      "id": 15,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 50
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "rawSql": "SELECT role, active, two_factor AS \"two-factor\", sso_linked AS \"SSO linked\", users FROM analytics.user_summary ORDER BY role, active DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
  ]
}
